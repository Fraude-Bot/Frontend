{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/eslint-after-agent-edits.sh",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/eslint-after-agent-edits.sh",
        "timeout": 120,
        "loop_limit": 2
      }
    ]
  }
}
