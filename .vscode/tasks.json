{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[ALL] Start Services",
      "type": "shell",
      "command": "FRAUDEBOT_UID=$(id -u) FRAUDEBOT_GID=$(id -g) docker compose up -d --build",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[ALL] Stop Services",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[ALL] Restart Services",
      "type": "shell",
      "command": "docker compose restart",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Stop Service",
      "type": "shell",
      "command": "docker compose stop backend",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[Web] Stop Service",
      "type": "shell",
      "command": "docker compose stop web",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[Frontend] Stop Service",
      "type": "shell",
      "command": "docker compose stop frontend",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[DB] Stop Service",
      "type": "shell",
      "command": "docker compose stop db",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[Cache] Stop Service",
      "type": "shell",
      "command": "docker compose stop cache",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Run PHPUnit Tests",
      "type": "shell",
      "command": "docker compose run --rm --no-deps backend ./vendor/bin/phpunit tests",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Run PHPUnit Tests (debug output)",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend ./vendor/bin/phpunit --debug --filter ${input:phpunitFilter}",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Run Artisan Command",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend php artisan ${input:artisanCommand}",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Truncate All Tables",
      "type": "shell",
      "command": "docker compose exec -T -w /var/www/backend backend php artisan db:truncate --force",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Backend] Seed Database with Mock Data",
      "type": "shell",
      "command": "docker compose exec -T -e SEED_SCAMMERS=${input:seedScammers} -e SEED_CONTACTS=${input:seedContacts} -e SEED_ORGANIZATIONS=${input:seedOrganizations} -e SEED_REPORTS=${input:seedReports} -e SEED_USERS=${input:seedUsers} -e SEED_PRODUCTS=${input:seedProducts} -w /var/www/backend backend php artisan db:seed --class=TestSeeder",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Frontend] Execute Command",
      "type": "shell",
      "command": "docker compose exec -T -w /app/ frontend sh -c \"${input:frontendCommand}\"",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Frontend] [Testing] Create Coverage Report",
      "type": "shell",
      "command": "docker compose exec -T -w /app/ frontend npm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/../docker/"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Frontend] [Testing] Run E2E Tests",
      "type": "shell",
      "command": "npm run test:e2e:docker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "[Workspace] Create Workspace",
      "type": "shell",
      "command": "REPO_ROOT=$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\") && WORKTREE_PATH=\"$REPO_ROOT/workspaces/${input:workspaceName}\" && git worktree add \"$WORKTREE_PATH\" main -b \"${input:workspaceBranch}\" && docker run -d --name \"fraudebot-frontend-${input:workspaceName}\" --network fraudebot_default -p \"${input:worktreePort}:80\" -v \"$WORKTREE_PATH:/app\" -v \"fraudebot-worktree-${input:workspaceName}-node-modules:/app/node_modules\" -w /app -e HOME=/tmp -e NPM_CONFIG_CACHE=/tmp/.npm -e VITE_API_PROXY_TARGET=http://web:80 node:20-alpine sh -c \"if [ -f package.json ]; then npm install && npm run dev; else tail -f /dev/null; fi\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "phpunitFilter",
      "type": "promptString",
      "description": "PHPUnit filter (e.g. PublicScammerControllerTest::testScammerSearchByCardNumber)",
      "default": "PublicScammerControllerTest"
    },
    {
      "id": "artisanCommand",
      "type": "promptString",
      "description": "Artisan command (e.g. php artisan db:seed)",
      "default": ""
    },
    {
      "id": "frontendCommand",
      "type": "promptString",
      "description": "Command to run in the frontend container (e.g. npm run lint, ls -la)",
      "default": ""
    },
    {
      "id": "seedScammers",
      "type": "promptString",
      "description": "SEED_SCAMMERS — number of scammers to create",
      "default": "1"
    },
    {
      "id": "seedContacts",
      "type": "promptString",
      "description": "SEED_CONTACTS — contacts per scammer/organization",
      "default": "3"
    },
    {
      "id": "seedOrganizations",
      "type": "promptString",
      "description": "SEED_ORGANIZATIONS — number of standalone organizations",
      "default": "1"
    },
    {
      "id": "seedReports",
      "type": "promptString",
      "description": "SEED_REPORTS — reports per scammer/organization",
      "default": "2"
    },
    {
      "id": "seedUsers",
      "type": "promptString",
      "description": "SEED_USERS — number of users to create",
      "default": "1"
    },
    {
      "id": "seedProducts",
      "type": "promptString",
      "description": "SEED_PRODUCTS — number of products to create",
      "default": "1"
    },
    {
      "id": "workspaceBranch",
      "type": "promptString",
      "description": "Workspace branch name (e.g. feature/feature-name)",
      "default": "feature/"
    },
    {
      "id": "workspaceName",
      "type": "promptString",
      "description": "Workspace location (e.g. feature-name)",
      "default": "feature-name"
    },
    {
      "id": "worktreePort",
      "type": "promptString",
      "description": "Worktree port (e.g. 8081)",
      "default": "8081"
    }
  ]
}
