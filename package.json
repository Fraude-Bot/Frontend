{
  "name": "fraudebot-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "quality": "npm run lint && npm run test:coverage && npm run build && npm run audit",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker build -f Dockerfile.e2e -t frontend-e2e . && docker run --rm -e CI=true -v \"$(pwd)/playwright-report:/app/playwright-report\" -v \"$(pwd)/test-results:/app/test-results\" frontend-e2e",
    "test:e2e:docker:build": "docker build -f Dockerfile.e2e -t frontend-e2e .",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.1",
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.11.3",
    "axios": "^1.14.0",
    "chart.js": "^4.5.1",
    "html-to-image": "^1.11.13",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-x64": "^1.0.0-rc.17"
  }
}
