{
  "name": "fraudebot-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "build:prerender": "npm run build:client && SEO_PROFILE_FEED_URL=http://localhost:9000/api/public/seo/profiles/ VITE_SITE_URL=http://localhost/ VITE_API_BASE_URL=http://localhost:9000/api node scripts/prerender-public-profiles.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "contract:check": "node scripts/check-openapi.mjs",
    "quality": "npm run lint && npm run test:coverage && npm run build && npm run audit",
    "test:e2e": "playwright test",
    "test:e2e:docker": "bash scripts/run-e2e-docker.sh",
    "test:e2e:docker:build": "docker build -f Dockerfile.e2e -t frontend-e2e .",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.1",
    "@tailwindcss/vite": "^4.2.2",
    "@xyflow/react": "^12.11.3",
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "html-to-image": "^1.11.13",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "react-tag-autocomplete": "^7.5.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-x64": "^1.0.0-rc.17"
  },
  "overrides": {
    "minimatch@<4": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.12"
    },
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2"
  }
}
